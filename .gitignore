# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brand asset source pack (raw multi-resolution PNGs; only the specific
# files copied into public/brand/ and src/app/ are tracked)
/odoowebapps_brand_pack/
/OdooWebApps_Brand_Pack.zip

# rendered on the demo VM only
infra/odoo-demo/odoo.conf
infra/odoo-demo/.env
