[options]
; Rendered to odoo.conf by bootstrap.sh, which fills in the master password.
; Connection details come from the container environment (HOST/USER/PASSWORD).
admin_passwd = __ADMIN_PASSWD__
addons_path = /mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
data_dir = /var/lib/odoo

; Only the public demo database is reachable over HTTP; the template it is
; restored from every night is invisible to the web.
db_name = odoo_demo
dbfilter = ^odoo_demo$
list_db = False

; Behind Caddy.
proxy_mode = True

; Sized for the Oracle Always Free Ampere A1 shape (2 OCPU, 12 GB).
workers = 2
max_cron_threads = 1
limit_memory_hard = 2684354560
limit_memory_soft = 2147483648
limit_request = 8192
limit_time_cpu = 60
limit_time_real = 120

log_level = warn
